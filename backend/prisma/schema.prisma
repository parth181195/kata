generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

model User {
  id            String         @id @default(uuid())
  googleSub     String         @unique
  email         String         @unique
  /// Public @handle for credit lines (cards, creator pages). Lowercase, unique, optional until claimed.
  handle        String?        @unique
  displayName   String
  photoUrl      String?
  role          Role           @default(user)
  createdAt     DateTime       @default(now())
  recipes       Recipe[]
  favourites    Favourite[]
  refreshTokens RefreshToken[]
  reports       Report[]
  cameras       UserCamera[]

  @@map("users")
}

/// A camera body an account has connected over USB (model + firmware, no serials). Upserted on each connection.
model UserCamera {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  model      String
  firmware   String
  pid        Int?
  slots      Int
  props      Int      @default(0)
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  seenCount  Int      @default(1)

  @@unique([userId, model, firmware])
  @@index([model])
  @@map("user_cameras")
}

model RefreshToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Recipe {
  id                String      @id @default(uuid())
  hash              String      @unique
  ofr               Json
  name              String
  filmSim           String
  isMono            Boolean
  sensors           String[]
  sourceUrl         String?
  sourceAttribution String?
  author            User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId          String?
  reviewed          Boolean     @default(false)
  hidden            Boolean     @default(false)
  reportCount       Int         @default(0)
  favouritesCount   Int         @default(0)
  imageUrls         String[]
  /// Bumped on every owner edit; RecipeVersion keeps the last 10 snapshots.
  version           Int         @default(1)
  search            Unsupported("tsvector")?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  favourites        Favourite[]
  reports           Report[]
  versions          RecipeVersion[]

  @@index([hidden, createdAt(sort: Desc)])
  @@index([hidden, favouritesCount(sort: Desc)])
  @@index([filmSim])
  @@index([isMono])
  @@index([search], type: Gin, map: "recipes_search_idx")
  @@index([sensors], type: Gin, map: "recipes_sensors_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "recipes_name_trgm_idx")
  @@map("recipes")
}

/// Snapshot of a recipe's OFR at a given version (owner edits only; pruned to the last 10).
model RecipeVersion {
  id        String   @id @default(uuid())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String
  version   Int
  name      String
  ofr       Json
  createdAt DateTime @default(now())

  @@unique([recipeId, version])
  @@map("recipe_versions")
}

model Favourite {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId  String
  createdAt DateTime @default(now())

  @@id([userId, recipeId])
  @@map("favourites")
}

model Report {
  id         String    @id @default(uuid())
  recipe     Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId   String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([recipeId, userId])
  @@map("reports")
}
